# ===========================================
# AuroraWA - VPS Production Template
# ===========================================
# Generate .env with `npm run env:generate -- .env .env.vps.example`
# before starting the Docker Compose production stack.

NODE_ENV=production
PORT=2785
LOG_LEVEL=info

# Public domain
DOMAIN=wapsystem.online
BASE_URL=https://wapsystem.online
DASHBOARD_URL=https://wapsystem.online
CORS_ORIGINS=https://wapsystem.online,https://www.wapsystem.online

# Session boot behavior
AUTO_START_SESSIONS=true
SESSION_MAX_RECONNECT_ATTEMPTS=0
SESSION_RECONNECT_BASE_DELAY=5000
SESSION_HISTORY_SYNC_LIMIT=500
SESSION_HISTORY_SYNC_DELAY_MS=75

# Dashboard + Swagger
SERVE_DASHBOARD=true
ENABLE_SWAGGER=false

# Core engine
ENGINE_TYPE=evolution-go
EVOLUTION_GO_VERSION=0.7.2
EVOLUTION_GO_BASE_URL=http://evolution-go:8080
EVOLUTION_GO_API_KEY=
EVOLUTION_GO_INSTANCE_TOKEN_SECRET=
EVOLUTION_GO_REQUEST_TIMEOUT_MS=30000
EVOLUTION_GO_HEALTH_INTERVAL_MS=15000
EVOLUTION_GO_WS_RECONNECT_DELAY_MS=1000
EVOLUTION_OPERATOR_EMAIL=
EVOLUTION_GO_LOG_LEVEL=INFO
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

# If you install system Chromium later, uncomment this:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Storage / database
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=openwa
DATABASE_USERNAME=openwa
DATABASE_PASSWORD=
MAIN_DATABASE_SYNCHRONIZE=true
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

# Durable send retry
MESSAGE_RETRY_ENABLED=true
MESSAGE_RETRY_POLL_MS=10000
MESSAGE_RETRY_MAX_ATTEMPTS=5
MESSAGE_RETRY_BASE_DELAY_MS=15000
MESSAGE_PENDING_STALE_MS=120000
MESSAGE_RETRY_BATCH_SIZE=25

# Queue / cache
REDIS_ENABLED=false
REDIS_BUILTIN=false
QUEUE_ENABLED=false
CACHE_ENABLED=false

# Security
WEBHOOK_SSRF_PROTECT=true
BODY_SIZE_LIMIT=25mb

# Aurora role defaults
OMEGA_ADMIN_EMAIL=masteradmin@auroramy.com
OMEGA_ADMIN_PASSWORD=Abcd1234
OMEGA_SUPPORT_EMAIL=superadmin@auroramy.com
OMEGA_AUTH_SESSION_TTL_HOURS=12
OMEGA_OPENWA_API_BASE_URL=/api

# OpenWA sync
OPENWA_BASE_URL=https://wapsystem.online
OPENWA_API_KEY=

# Optional API master key
# API_MASTER_KEY=replace-with-a-long-random-secret
